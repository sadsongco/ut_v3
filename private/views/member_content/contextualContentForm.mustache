{{#text_fields}}
    <label for="content-heading">Content Heading</label>
    <input
        id="content-heading"
        type="text"
        name="title"
        placeholder="content heading"
        value="{{title}}"
        hx-post="/private/functions/interface/member_content/article_preview.php"
        hx-trigger="keyup changed delay:1s"
        hx-target="#articlePreviewContainer" 
    >
    <label for="content-body">Content Body</label>
    <textarea
        id="content-body"
        name="body"
        placeholder="content body"
        hx-post="/private/functions/interface/member_content/article_preview.php"
        hx-trigger="keyup changed delay:1s"
        hx-target="#articlePreviewContainer"
    >{{body}}</textarea>
{{/text_fields}}
{{#file_field}}
    <label for="content-upload">Content Upload</label>
    <input id="content-upload" type="file" name="files[]" accept="{{accept}}">
{{/file_field}}

{{^text_fields}}
    INVALID CONTENT TYPE
{{/text_fields}}

{{#text_fields}}
    <label for="content-pub-date">Content Publication Date</label>
    <input id="content-pub-date" type="datetime-local" name="pub_date" value="{{date}}">
    <input type="submit" id="member-content-subscribe" value="Create Member Content">
{{/text_fields}}

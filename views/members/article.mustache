<section class="article-container">
{{#content}}
    <article class="article-body">
    {{#content_heading}}
        <div class="article-head">
         <div class="article-title">{{content_heading}}</div>
         <div class="article-date">{{date}}</div>
        </div>
    {{/content_heading}}
    {{#content_body}}
        <div class="article-content">
            <p>{{{content_body}}}</p>
        </div>
    {{/content_body}}
    {{#audio}}
        <div class="spinner htmx-indicator" id="spinner">
            <img src="/serve/images/graphics/loading/gif/inline" alt="loading spinner" />
        </div>
        <div hx-post="/controllers/audio_player.php" hx-vals='{{track}}' hx-trigger="load" hx-target="this" hx-swap="outerHTML" htmx-indicator="#spinner"></div>
    {{/audio}}
    </article>
{{/content}}
</section>
<section class="article-container">
{{#content}}
    <article class="article-body">
    {{#title}}
        <div class="article-head">
         <div class="article-title">{{title}}</div>
         <div class="article-date">{{date}}</div>
        </div>
    {{/title}}
    {{#body}}
        <div class="article-content">
            <p>{{{body}}}</p>
        </div>
    {{/body}}
    {{#audio}}
        <div class="spinner htmx-indicator" id="spinner">
            <img src="/serve/images/graphics/loading/gif/inline" alt="loading spinner" />
        </div>
        <div hx-post="/controllers/audio_player.php" hx-vals='{{track}}' hx-trigger="load" hx-target="this" hx-swap="outerHTML" hx-indicator="#spinner"></div>
    {{/audio}}
    </article>
{{/content}}
</section>